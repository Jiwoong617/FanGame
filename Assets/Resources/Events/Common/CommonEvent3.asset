    resultText: "\uADC0\uAC00 \uB4E4\uB9AC\uC9C0 \uC54A\uB294 \uC0C1\uD0DC\uC5D0\uC11C
      \uC785\uBAA8\uC591\uC73C\uB85C \uB2E8\uC5B4\uB97C \uB9DE\uCD94\uB294 \uD589\uC0AC\uB77C\uACE0
