  options:
  - buttonText: "\uB2F4\uC720\uC774"
    resultText: "\uBC18\uAC11\uAC8C \uB9DE\uC774\uD574\uC8FC\uBA70 \uC190\uC218\uD574\uC900
      \uC694\uB9AC\uB97C \uB300\uC811\uBC1B\uC558\uB2E4.\n\uC544\uAC00\uC528\uB791
