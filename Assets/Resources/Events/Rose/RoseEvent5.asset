    - rid: 7988895521758773350
  - buttonText: "\uB9DD\uB0B4"
    resultText: "\uB9DD\uB0B4\uB97C \uBCF4\uC790 \uC544\uAC00\uC528 \uBC1B\uC558\uB358
      \uC120\uBB3C\uC774 \uC0DD\uAC01\uB098 \uAC74\uB138\uB2E4. \uC120\uBB3C \uC0C1\uC790
